# Copy this file to `.env.local` and fill in the values below.
# `.env.local` is already git-ignored. Restart `npm run dev` after editing it.


# --- Supabase: the content database and the admin login -----------------------
# Both from the Supabase dashboard: Project Settings -> API Keys.
#
# There is no service-role key here on purpose — the admin panel writes as the
# signed-in user and the database's row level security decides what that user
# may change, so no Supabase secret is ever shipped to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY


# --- Cloudinary: image hosting ------------------------------------------------
# Copy the "API environment variable" line from the Cloudinary dashboard
# (Settings -> API Keys). It already contains all three parts.
#
# It must stay on ONE line — the cloud name after the @ belongs on the same line
# as the key and secret, however the dashboard wraps it when displayed.
#
# No NEXT_PUBLIC_ prefix, deliberately: the secret stays on the server, and the
# browser is handed a short-lived upload signature instead. Uploading is
# optional — every image field also accepts a plain link.

CLOUDINARY_URL=cloudinary://YOUR-API-KEY:YOUR-API-SECRET@YOUR-CLOUD-NAME

# Or, if you prefer them separately, delete the line above and use these three:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
